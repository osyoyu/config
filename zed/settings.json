// https://zed.dev/docs/configuring-zed
{
  // Editor
  "vim_mode": true,
  "use_autoclose": false,
  "use_auto_surround": false,
  "format_on_save": "off",
  "file_types": {
    "YAML/ERB": ["database.yml"]
  },

  // Appearance
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "IBM Plex Mono",
  "buffer_font_fallbacks": ["Osaka"], // こんにちは
  "buffer_font_features": {
    "calt": false
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "project_panel": { "default_width": 640 },
  "outline_panel": { "dock": "right" },
  "git_panel": { "button": false },
  "collaboration_panel": { "button": false },
  "gutter": {
    "line_numbers": false,
    "breakpoints": false,
    "folds": false,
    "runnables": false,
    "min_line_number_digits": 0,
  },

  // Completions and Predictions
  "completions": {
    "words": "enabled"
  },
  "edit_predictions": {
    "provider": "copilot",
    "disabled_globs": ["*.json", "*.md", "*.yml"]
  },
  "agent": {
    "dock": "right",
    "default_width": 780.0,
    "max_content_width": 1200.0,
    "limit_content_width": true,
    "flexible": false,
    "use_modifier_to_send": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-3.5-sonnet"
    }
  },
  "inlay_hints": {
    "enabled": true
  },

  // Language-specific
  "languages": {
    "Ruby": {
      "format_on_save": "on",
      "language_servers": ["ruby-lsp", "!sorbet", "!steep", "!solargraph", "!rubocop", "!fuzzy-ruby-server", "!kanayago", "..."]
    }
  },

  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "enabled_features": {
          "onTypeFormatting": false
        },
        "addonSettings": {
          "Ruby LSP Rails": {
            "enablePendingMigrationsPrompt": false
          }
        }
      }
    }
  }
}

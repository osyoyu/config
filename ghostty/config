term = xterm-256color

font-size = 14
font-family = "Comic Code"
font-family = "Monaco"
# don't forget to disable the proportional version
font-family = "Osaka"
font-feature = -calt
font-feature = -liga
font-feature = -dlig
window-padding-x = 4
macos-non-native-fullscreen = true
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true

keybind = alt+left=unbind
keybind = alt+right=unbind
